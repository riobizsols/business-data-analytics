# Set at BUILD time (package_for_deploy.ps1 -ApiBase ...).
# Address the browser uses to reach the backend, e.g. https://api.example.com
# Leave empty only if a reverse proxy serves /api and /auth on the same host as the site.
NEXT_PUBLIC_API_BASE=

# Set at RUN time on the server.
# Address the Next.js server uses to reach the backend for server-rendered pages.
# Defaults to NEXT_PUBLIC_API_BASE when unset.
API_INTERNAL_BASE=http://127.0.0.1:8000

PORT=3000
HOSTNAME=0.0.0.0
