# Copy to deploy/vps.env on the server. Never commit deploy/vps.env.

# Existing Postgres. Avoid "$" in passwords (docker compose treats it as a variable).
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@DB_HOST:5432/bdata_db?sslmode=disable

PUBLIC_ORIGIN=https://bda.rioassetmanagement.net

# Host port for the internal nginx (bound to 127.0.0.1 only). Must be free on the VPS.
BDA_HTTP_PORT=8095

# Created on first start only if this username does not exist in the users table.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@rioassetmanagement.net

# Database protection. Max DB connections = API_WORKERS * (DB_POOL_SIZE + DB_MAX_OVERFLOW).
API_WORKERS=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=60000
DB_IDLE_IN_TX_TIMEOUT_MS=60000
STATS_CACHE_TTL_SECONDS=600

# Container resource caps so the app cannot starve other services.
API_CPUS=1.5
API_MEMORY=1g
WEB_CPUS=1.0
WEB_MEMORY=768m

