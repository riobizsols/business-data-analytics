# Copy to deploy/.env and change every password before starting the server.
POSTGRES_DB=bdata_db
POSTGRES_USER=bdata_user
POSTGRES_PASSWORD=change-me

# Created on first start if this username does not already exist.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
ADMIN_EMAIL=admin@bdataui.com

# Public site origin, used for CORS. The browser talks only to the proxy port.
PUBLIC_ORIGIN=http://your-server
HTTP_PORT=80
