# Copy to .env and adjust as needed. Values here are defaults from the spec.
# Prefer a single DATABASE_URL; DB_* vars are used if DATABASE_URL is not set.

# Example unified URL (recommended)
DATABASE_URL=postgresql://bdata_user:bdata_password@localhost:5432/bdata_db

# Individual vars (fallbacks)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bdata_db
DB_USER=bdata_user
DB_PASSWORD=bdata_password

# Local sign-in accounts live in .env (ADMIN_USERNAME, ADMIN_PASSWORD, VIEWER1_* ...).
# Do not put real passwords in this example file.
