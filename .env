# Copy to .env and adjust as needed. Values here are defaults from the spec.
# Prefer a single DATABASE_URL; DB_* vars are used if DATABASE_URL is not set.

# Example unified URL (recommended)
DATABASE_URL=postgresql://bdata_user:bdata_password@localhost:5432/bdata_db

# Individual vars (fallbacks)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bdata_db
DB_USER=bdata_user
DB_PASSWORD=bdata_password

# Local sign-in accounts. These are not shown on the login page.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

VIEWER1_USERNAME=viewer1
VIEWER1_PASSWORD=ViewOnly1
VIEWER2_USERNAME=viewer2
VIEWER2_PASSWORD=ViewOnly2
VIEWER3_USERNAME=viewer3
VIEWER3_PASSWORD=ViewOnly3
VIEWER4_USERNAME=viewer4
VIEWER4_PASSWORD=ViewOnly4
VIEWER5_USERNAME=viewer5
VIEWER5_PASSWORD=ViewOnly5
